{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "panorama",
  "displayName": "Panorama",
  "displayOption": "FitToPage",
  "height": 720,
  "width": 1280,
  "objects": {
    "background": [
      {
        "properties": {
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'bg_panorama.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "bg_panorama.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#13121D'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "visualInteractions": [
    {
      "source": "slc_categoria",
      "target": "categorias",
      "type": "NoFilter"
    },
    {
      "source": "slc_categoria",
      "target": "composicion",
      "type": "NoFilter"
    },
    {
      "source": "slc_categoria",
      "target": "insight",
      "type": "NoFilter"
    },
    {
      "source": "slc_categoria",
      "target": "varObras",
      "type": "NoFilter"
    },
    {
      "source": "slc_categoria",
      "target": "varServicios",
      "type": "NoFilter"
    },
    {
      "source": "slc_categoria",
      "target": "varBienes",
      "type": "NoFilter"
    },
    {
      "source": "slc_nivel",
      "target": "nivel_barra",
      "type": "NoFilter"
    },
    {
      "source": "slc_nivel",
      "target": "nivelNacional",
      "type": "NoFilter"
    },
    {
      "source": "slc_nivel",
      "target": "nivelLocal",
      "type": "NoFilter"
    },
    {
      "source": "slc_nivel",
      "target": "nivelRegional",
      "type": "NoFilter"
    }
  ]
}