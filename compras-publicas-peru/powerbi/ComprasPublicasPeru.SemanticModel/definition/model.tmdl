model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-PE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["RutaDatos"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table dim_fecha
ref table dim_entidad
ref table dim_metodo
ref table dim_categoria
ref table dim_proveedor
ref table fact_proceso
ref table fact_adjudicacion
ref table sel_anio
ref table Medidas
