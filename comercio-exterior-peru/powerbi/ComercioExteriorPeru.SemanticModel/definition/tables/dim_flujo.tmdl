table dim_flujo
	lineageTag: 827e747f-7d98-48f2-8dbd-8f200af2db8d

	column flujo_cod
		dataType: string
		lineageTag: ad3e8aa1-162d-48f9-9757-4c6e1f6e05a1
		summarizeBy: none
		sourceColumn: flujo_cod

	column flujo
		dataType: string
		lineageTag: 086a552b-8bd2-48a9-bbbb-8655adf2f048
		summarizeBy: none
		sourceColumn: flujo

	partition dim_flujo = m
		mode: import
		source =
				let
				    Origen = Csv.Document ( File.Contents ( RutaDatos & "dim_flujo.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Encabezados = Table.PromoteHeaders ( Origen, [PromoteAllScalars = true] ),
				    Tipado = Table.TransformColumnTypes ( Encabezados, {{"flujo_cod", type text}, {"flujo", type text}}, "en-US" )
				in
				    Tipado

