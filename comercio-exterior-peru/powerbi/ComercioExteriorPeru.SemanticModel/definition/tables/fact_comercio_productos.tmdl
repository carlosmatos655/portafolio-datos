table fact_comercio_productos
	lineageTag: 10e80754-eab8-4368-85fc-9a177f15ec0f

	column fecha
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: ab5d04fa-1404-4b97-a726-0663592ab2b5
		summarizeBy: none
		sourceColumn: fecha

		annotation UnderlyingDateTimeDataType = Date

	column flujo_cod
		dataType: string
		lineageTag: dfa8f25b-b559-4841-83fa-b7e87020ab6b
		summarizeBy: none
		sourceColumn: flujo_cod

	column capitulo
		dataType: string
		lineageTag: 26c6b04e-052c-415c-9bd9-52364f0d993f
		summarizeBy: none
		sourceColumn: capitulo

	column valor_usd
		dataType: double
		lineageTag: 6a91bcde-c5b2-43ce-af3a-376f8577dd8f
		summarizeBy: none
		sourceColumn: valor_usd

	partition fact_comercio_productos = m
		mode: import
		source =
				let
				    Origen = Csv.Document ( File.Contents ( RutaDatos & "fact_comercio_productos.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Encabezados = Table.PromoteHeaders ( Origen, [PromoteAllScalars = true] ),
				    Tipado = Table.TransformColumnTypes ( Encabezados, {{"fecha", type date}, {"flujo_cod", type text}, {"capitulo", type text}, {"valor_usd", type number}}, "en-US" )
				in
				    Tipado

