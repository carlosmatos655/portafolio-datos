table fact_comercio_socios
	lineageTag: 1d046a5c-a0c8-4c4e-8393-03a61e399a63

	column fecha
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: c4b7fe63-63b6-470f-8dba-f9023df2309a
		summarizeBy: none
		sourceColumn: fecha

		annotation UnderlyingDateTimeDataType = Date

	column flujo_cod
		dataType: string
		lineageTag: bef64477-fb99-4e9f-94b5-89a1ccb0f4db
		summarizeBy: none
		sourceColumn: flujo_cod

	column pais_cod
		dataType: int64
		lineageTag: 615ad5aa-910a-4a98-932c-81fec91a4a73
		summarizeBy: none
		sourceColumn: pais_cod

	column valor_usd
		dataType: double
		lineageTag: d71f2c3f-9988-4b98-ad24-b29a9b78247a
		summarizeBy: none
		sourceColumn: valor_usd

	partition fact_comercio_socios = m
		mode: import
		source =
				let
				    Origen = Csv.Document ( File.Contents ( RutaDatos & "fact_comercio_socios.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Encabezados = Table.PromoteHeaders ( Origen, [PromoteAllScalars = true] ),
				    Tipado = Table.TransformColumnTypes ( Encabezados, {{"fecha", type date}, {"flujo_cod", type text}, {"pais_cod", Int64.Type}, {"valor_usd", type number}}, "en-US" )
				in
				    Tipado

