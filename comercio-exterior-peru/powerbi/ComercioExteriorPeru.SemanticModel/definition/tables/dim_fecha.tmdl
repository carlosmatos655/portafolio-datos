table dim_fecha
	lineageTag: dc12670e-ade8-49dc-892b-784d7fc0c232

	column fecha
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: f71b049f-721f-434a-9736-f51602893fdb
		summarizeBy: none
		sourceColumn: fecha

		annotation UnderlyingDateTimeDataType = Date

	column anio
		dataType: int64
		lineageTag: 015a99e3-3e65-4cf9-911d-fb0a1ad3fcf3
		summarizeBy: none
		sourceColumn: anio

	column mes
		dataType: int64
		lineageTag: 52218475-2e00-4d05-a4a4-bc628277599a
		summarizeBy: none
		sourceColumn: mes

	column mes_nombre
		dataType: string
		lineageTag: 8d7786ae-e62e-4edd-9f47-e97cc30e13f7
		summarizeBy: none
		sourceColumn: mes_nombre

	column trimestre
		dataType: string
		lineageTag: 3a153c31-ba14-412e-8509-0912bd78b66f
		summarizeBy: none
		sourceColumn: trimestre

	column anio_mes
		dataType: string
		lineageTag: af82c0a1-d42d-4768-b340-636a3f977014
		summarizeBy: none
		sourceColumn: anio_mes

	partition dim_fecha = m
		mode: import
		source =
				let
				    Origen = Csv.Document ( File.Contents ( RutaDatos & "dim_fecha.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Encabezados = Table.PromoteHeaders ( Origen, [PromoteAllScalars = true] ),
				    Tipado = Table.TransformColumnTypes ( Encabezados, {{"fecha", type date}, {"anio", Int64.Type}, {"mes", Int64.Type}, {"mes_nombre", type text}, {"trimestre", type text}, {"anio_mes", type text}}, "en-US" )
				in
				    Tipado

