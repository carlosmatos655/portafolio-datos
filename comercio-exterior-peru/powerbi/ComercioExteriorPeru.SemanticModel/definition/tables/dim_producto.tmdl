table dim_producto
	lineageTag: 8b2cee7e-1545-44c9-8edb-229bc06e1beb

	column capitulo
		dataType: string
		lineageTag: cb95737f-7c94-4a87-bb0c-0ef9a78b63c1
		summarizeBy: none
		sourceColumn: capitulo

	column producto
		dataType: string
		lineageTag: 53045265-24b6-4b75-aa49-1ad6481e3378
		summarizeBy: none
		sourceColumn: producto

	column sector
		dataType: string
		lineageTag: 5344666e-dc7d-4a97-b682-839de9e2730b
		summarizeBy: none
		sourceColumn: sector

	column capitulo_producto
		dataType: string
		lineageTag: 206f89b5-c6eb-4bf6-846c-a61c851825da
		summarizeBy: none
		sourceColumn: capitulo_producto

	partition dim_producto = m
		mode: import
		source =
				let
				    Origen = Csv.Document ( File.Contents ( RutaDatos & "dim_producto.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Encabezados = Table.PromoteHeaders ( Origen, [PromoteAllScalars = true] ),
				    Tipado = Table.TransformColumnTypes ( Encabezados, {{"capitulo", type text}, {"producto", type text}, {"sector", type text}, {"capitulo_producto", type text}}, "en-US" )
				in
				    Tipado

