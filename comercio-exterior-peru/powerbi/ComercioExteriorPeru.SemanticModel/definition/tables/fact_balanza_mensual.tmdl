table fact_balanza_mensual
	lineageTag: a50aaa18-cd78-4cca-bfdc-43b05313c1a3

	column fecha
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: dcca05c2-3c6b-4e92-bd4f-575510955208
		summarizeBy: none
		sourceColumn: fecha

		annotation UnderlyingDateTimeDataType = Date

	column flujo_cod
		dataType: string
		lineageTag: 38f56f5d-1909-4d70-b796-51103c79f931
		summarizeBy: none
		sourceColumn: flujo_cod

	column grupo
		dataType: string
		lineageTag: a2e76b5b-b4cc-4742-9377-eeabbe98ff87
		summarizeBy: none
		sourceColumn: grupo

	column valor_musd
		dataType: double
		lineageTag: e7e444f4-0f87-4712-9ea6-ff4a2f613f6c
		summarizeBy: none
		sourceColumn: valor_musd

	partition fact_balanza_mensual = m
		mode: import
		source =
				let
				    Origen = Csv.Document ( File.Contents ( RutaDatos & "fact_balanza_mensual.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Encabezados = Table.PromoteHeaders ( Origen, [PromoteAllScalars = true] ),
				    Tipado = Table.TransformColumnTypes ( Encabezados, {{"fecha", type date}, {"flujo_cod", type text}, {"grupo", type text}, {"valor_musd", type number}}, "en-US" )
				in
				    Tipado

