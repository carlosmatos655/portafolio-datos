table dim_pais
	lineageTag: b4bd289b-97c1-43d1-ba64-fad52c7b06f8

	column pais_cod
		dataType: int64
		lineageTag: e37a3018-63f4-4708-964e-b9e2aba82661
		summarizeBy: none
		sourceColumn: pais_cod

	column iso3
		dataType: string
		lineageTag: 40876a77-f2c4-4f42-8aa8-d42061744f95
		summarizeBy: none
		sourceColumn: iso3

	column iso2
		dataType: string
		lineageTag: 3636b683-53de-48dc-a69f-0e7ddd11928f
		summarizeBy: none
		sourceColumn: iso2

	column pais
		dataType: string
		lineageTag: 4421f3a6-5e55-4541-a938-9948c5f7426a
		summarizeBy: none
		sourceColumn: pais

	column continente
		dataType: string
		lineageTag: d44eab44-2b5e-4d79-b38a-69f382eda84c
		summarizeBy: none
		sourceColumn: continente

	partition dim_pais = m
		mode: import
		source =
				let
				    Origen = Csv.Document ( File.Contents ( RutaDatos & "dim_pais.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Encabezados = Table.PromoteHeaders ( Origen, [PromoteAllScalars = true] ),
				    Tipado = Table.TransformColumnTypes ( Encabezados, {{"pais_cod", Int64.Type}, {"iso3", type text}, {"iso2", type text}, {"pais", type text}, {"continente", type text}}, "en-US" )
				in
				    Tipado

