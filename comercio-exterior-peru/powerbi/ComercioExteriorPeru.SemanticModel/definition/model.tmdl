model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-PE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["RutaDatos","dim_fecha","dim_flujo","dim_pais","dim_producto","fact_balanza_mensual","fact_comercio_socios","fact_comercio_productos"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table dim_fecha
ref table dim_flujo
ref table dim_pais
ref table dim_producto
ref table fact_balanza_mensual
ref table fact_comercio_socios
ref table fact_comercio_productos
ref table Medidas

ref cultureInfo en-US

